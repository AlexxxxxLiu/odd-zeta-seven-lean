    ∃ c ∈ savedProfile, c.left < (p : ℚ)/n ∧ (p : ℚ)/n ≤ c.right ∧
      (-(padicValRat p (h158PrimitiveScalar n)) : ℚ) ≤
        (n : ℚ)*c.cost.eval ((p : ℚ)/n)+4635 := by
  obtain ⟨c, hc, ha, hb, hcost⟩ := savedCertificate.actual_cost
    savedCertificate_checked n hn hlo hhi hsq hdet
  refine ⟨c.toProfile, ?_, ha, hb, hcost⟩
  rw [← savedCells_projection]
  exact List.mem_map.mpr ⟨c, hc, rfl⟩

